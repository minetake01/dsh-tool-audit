{
  "name": "dsh-tool-audit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Observes tool calls, hashes the binaries they run, and records one audit line per call.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minetake01/dsh-tool-audit.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "audit",
    "decision-model"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/routes.mjs && node test/gate.mjs && node test/releases.mjs && node test/enforce.mjs && node test/client.mjs"
  }
}
